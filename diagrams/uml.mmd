classDiagram
    %% PawPal+ core domain model
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_time_today
        +dict preferences
        +add_pet(pet) None
        +add_task(task) None
        +set_constraint(key, value) None
    }

    class Pet {
        +str name
        +str species
        +int age
    }

    class Task {
        +str name
        +str type
        +int duration
        +int priority
        +tuple preferred_time_window
        +bool recurring
        +conflicts_with(other) bool
    }

    class Scheduler {
        +list~Task~ tasks
        +dict constraints
        +generate_schedule() list~Task~
        +explain_reasoning() str
        +sort_by_priority() list~Task~
        +detect_conflicts() list
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : needs
    Owner "1" --> "1" Scheduler : uses
    Scheduler "1" o-- "*" Task : schedules
    Task "*" --> "1" Pet : for
