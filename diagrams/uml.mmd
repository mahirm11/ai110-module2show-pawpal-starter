classDiagram
    %% PawPal+ core domain model
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_time_today
        +dict preferences
        +add_pet(pet) None
        +remove_pet(pet) None
        +add_task(task) None
        +remove_task(task) None
        +all_tasks() list~Task~
        +tasks_for_pet(name) list~Task~
        +set_constraint(key, value) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +add_task(task) None
        +remove_task(task) None
        +get_tasks() list~Task~
        +pending_tasks() list~Task~
    }

    class Task {
        +str name
        +str type
        +int duration
        +int priority
        +tuple preferred_time_window
        +bool recurring
        +bool completed
        +tuple scheduled_time
        +conflicts_with(other) bool
        +mark_done() None
    }

    class Scheduler {
        +list~Task~ tasks
        +dict constraints
        +generate_schedule() Schedule
        +explain_reasoning() str
        +sort_by_priority() list~Task~
        +sort_by_time() list~Task~
        +detect_conflicts() list~tuple~
    }

    class Schedule {
        +list~Task~ scheduled
        +list~Task~ deferred
        +list~tuple~ conflicts
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : needs
    Owner "1" --> "1" Scheduler : uses
    Scheduler "1" o-- "*" Task : schedules
    Task "*" --> "1" Pet : for
    Scheduler "1" --> "0..1" Schedule : last_schedule
    Schedule "1" o-- "*" Task : contains
